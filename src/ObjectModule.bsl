// ВНЕШНЯЯ ОБРАБОТКА: Сжатие изображений номенклатуры
// Конфигурация: 1С:Управление торговлей 11 (УТ 11.4 / 11.5), КА 2, ERP 2
// Назначение: Оптимизация размера файлов картинок в базе и томах хранения
// =============================================================================

#Область ПрограммныйИнтерфейс

// Функция регистрации обработки в подсистеме "Дополнительные отчеты и обработки" (БСП).
// Позволяет подключить обработку через интерфейс:
// "НСИ и администрирование" -> "Печатные формы, отчеты и обработки" -> "Дополнительные отчеты и обработки".
//
// Возвращаемое значение:
//   Структура - параметры регистрации для БСП.
//
Функция СведенияОВнешнейОбработке() Экспорт
    
    ПараметрыРегистрации = Новый Структура;
    ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
    ПараметрыРегистрации.Вставить("Наименование", "Сжатие картинок номенклатуры");
    ПараметрыРегистрации.Вставить("Версия", "1.1.0");
    
    // ВАЖНО: БезопасныйРежим = Ложь необходим для использования COM-объекта WIA
    // и прямой работы с файлами в томах на диске и каталоге резервных копий.
    ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
    ПараметрыРегистрации.Вставить("Информация", 
        "Пакетное сжатие, масштабирование и конвертация присоединенных файлов изображений номенклатуры (в ИБ и томах на диске).");
    
    // Назначение обработки (разрешено вызывать из справочника Номенклатура)
    Назначение = Новый Массив;
    Назначение.Добавить("Справочник.Номенклатура");
    ПараметрыРегистрации.Вставить("Назначение", Назначение);
    
    // Таблица команд
    ТаблицаКоманд = Новый ТаблицаЗначений;
    ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
    ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
    ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
    ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
    ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
    
    Команда = ТаблицаКоманд.Добавить();
    Команда.Представление = "Сжатие картинок номенклатуры";
    Команда.Идентификатор = "СжатиеКартинокНоменклатуры";
    Команда.Использование = "ОткрытиеФормы";
    Команда.ПоказыватьОповещение = Ложь;
    Команда.Модификатор = "";
    
    ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
    
    Возврат ПараметрыРегистрации;
    
КонецФункции

#КонецОбласти
