// =============================================================================
// ВНЕШНЯЯ ОБРАБОТКА: Сжатие картинок номенклатуры (УТ 11 / КА 2 / ERP 2)
// МОДУЛЬ ФОРМЫ С АВТОМАТИЧЕСКИМ ПОСТРОЕНИЕМ ИНТЕРФЕЙСА (Self-Generating Form)
//
// ВАЖНО: При использовании этого модуля в Конфигураторе 1С НЕ ТРЕБУЕТСЯ
// вручную создавать реквизиты, колонки таблицы и элементы формы!
// Достаточно создать пустую основную форму обработки (нажать "Готово"),
// открыть её модуль и вставить этот код целиком.
// Все элементы, таблицы, группы и кнопки создадутся программно при открытии!
// =============================================================================

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    Попытка
        // Заголовок формы
        Заголовок = "Сжатие и оптимизация изображений номенклатуры (УТ 11 / ERP)";
        
        // 1. Программное создание всех реквизитов формы и колонок таблицы
        СоздатьРеквизитыФормыПрограммно();
        
        // 2. Программное создание команд формы
        СоздатьКомандыФормыПрограммно();
        
        // 3. Программное создание элементов интерфейса (поля, группы, таблица, кнопки)
        СоздатьЭлементыИнтерфейсаПрограммно();
        
        // 4. Инициализация параметров по умолчанию
        ЭтаФорма.МинимальныйРазмерКб         = 300;     // Искать файлы от 300 Кб
        ЭтаФорма.МаксимальнаяШирина          = 1600;    // Максимальная ширина картинки (px)
        ЭтаФорма.МаксимальнаяВысота          = 1600;    // Максимальная высота картинки (px)
        ЭтаФорма.КачествоJPEG                = 80;      // Баланс качества/размера (75-85)
        ЭтаФорма.КонвертироватьВJPEG         = Истина;  // Конвертировать PNG, BMP в JPEG
        ЭтаФорма.НеПерезаписыватьЕслиБольше  = Истина;  // Защита от деградации размера
        ЭтаФорма.ТестовыйРежим               = Истина;  // По умолчанию безопасный тестовый режим!
        ЭтаФорма.ОбрабатыватьВБазе           = Истина;  // Файлы в базе данных
        ЭтаФорма.ОбрабатыватьВТомах          = Истина;  // Файлы в томах на диске
        ЭтаФорма.СписокРасширений            = "jpg, jpeg, png, bmp";
        ЭтаФорма.ТолькоОсновноеИзображение   = Ложь;
        ЭтаФорма.СоздаватьРезервнуюКопию     = Ложь;
        ЭтаФорма.КаталогРезервныхКопий       = "";
        
        ОбновитьТекстИтогов();
        
    Исключение
        ВызватьИсключение "Ошибка автоматического создания интерфейса формы: " + ОписаниеОшибки();
    КонецПопытки;
    
КонецПроцедуры

#КонецОбласти

#Область ПрограммнаяГенерацияРеквизитовИИнтерфейса

&НаСервере
Процедура СоздатьРеквизитыФормыПрограммно()
    
    ДобавляемыеРеквизиты = Новый Массив;
    
    // --- Параметры отбора ---
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПапкаНоменклатуры",          Новый ОписаниеТипов("СправочникСсылка.Номенклатура"), , "Папка / подпапка"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ВидНоменклатуры",            Новый ОписаниеТипов("СправочникСсылка.ВидыНоменклатуры"), , "Вид номенклатуры"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ОтдельныйТовар",             Новый ОписаниеТипов("СправочникСсылка.Номенклатура"), , "Отдельный товар"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("МинимальныйРазмерКб",        Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)), , "Мин. размер (Кб)"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокРасширений",           Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)), , "Расширения"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ТолькоОсновноеИзображение",  Новый ОписаниеТипов("Булево"), , "Только основное фото"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ОбрабатыватьВБазе",          Новый ОписаниеТипов("Булево"), , "В информационной базе"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ОбрабатыватьВТомах",         Новый ОписаниеТипов("Булево"), , "В томах на диске"));
    
    // --- Параметры сжатия ---
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("МаксимальнаяШирина",         Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)), , "Макс. ширина (px)"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("МаксимальнаяВысота",         Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)), , "Макс. высота (px)"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КачествоJPEG",               Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0)), , "Качество JPEG (%)"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КонвертироватьВJPEG",        Новый ОписаниеТипов("Булево"), , "Конвертировать в JPEG"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НеПерезаписыватьЕслиБольше", Новый ОписаниеТипов("Булево"), , "Пропускать, если размер вырос"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ТестовыйРежим",              Новый ОписаниеТипов("Булево"), , "Тестовый режим (без записи)"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СоздаватьРезервнуюКопию",    Новый ОписаниеТипов("Булево"), , "Создавать бэкап оригиналов"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КаталогРезервныхКопий",      Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255)), , "Каталог бэкапа"));
    
    // --- Служебные реквизиты ---
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("АдресКартинкиПредпросмотра", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255)), , "Картинка"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ТекстИнформации",            Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)), , ""));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИтогиНайдено",               Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0))));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИтогиВыбрано",               Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0))));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИтогиИсходныйРазмерМб",     Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 2))));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИтогиЭкономияМб",           Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 2))));
    
    // --- Коллекция СписокФайлов (ТаблицаЗначений) ---
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокФайлов",               Новый ОписаниеТипов("ТаблицаЗначений")));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Пометка",                    Новый ОписаниеТипов("Булево"), "СписокФайлов", " "));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Номенклатура",               Новый ОписаниеТипов("СправочникСсылка.Номенклатура"), "СписокФайлов", "Номенклатура"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НоменклатураАртикул",        Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)), "СписокФайлов", "Артикул"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПрисоединенныйФайл",         Новый ОписаниеТипов("СправочникСсылка.НоменклатураПрисоединенныеФайлы"), "СписокФайлов", "Файл"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИмяФайла",                   Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)), "СписокФайлов", "Имя файла"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Расширение",                 Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)), "СписокФайлов", "Расш."));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ТипХранения",                Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)), "СписокФайлов", "Хранение"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИсходныйРазмерКб",           Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 2)), "СписокФайлов", "Исх. размер (Кб)"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИсходноеРазрешение",         Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)), "СписокФайлов", "Исх. разрешение"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НовыйРазмерКб",              Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 2)), "СписокФайлов", "Новый размер (Кб)"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НовоеРазрешение",            Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)), "СписокФайлов", "Новое разрешение"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ЭкономияКб",                 Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 2)), "СписокФайлов", "Экономия (Кб)"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ЭкономияПроцент",            Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 1)), "СписокФайлов", "Экономия (%)"));
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Статус",                     Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)), "СписокФайлов", "Статус обработки"));
    
    ИзменитьРеквизиты(ДобавляемыеРеквизиты);
    
КонецПроцедуры

&НаСервере
Процедура СоздатьКомандыФормыПрограммно()
    
    // Команда: Заполнить список
    КомандаЗаполнить = Команды.Добавить("КомандаЗаполнить");
    КомандаЗаполнить.Заголовок  = "Найти картинки";
    КомандаЗаполнить.Действие   = "ЗаполнитьСписок";
    
    // Команда: Выполнить сжатие
    КомандаСжать = Команды.Добавить("КомандаСжать");
    КомандаСжать.Заголовок      = "Выполнить сжатие";
    КомандаСжать.Действие       = "ВыполнитьСжатие";
    
    // Команда: Выбрать все
    КомандаВыбрать = Команды.Добавить("КомандаВыбратьВсе");
    КомандаВыбрать.Заголовок    = "Выбрать все";
    КомандаВыбрать.Действие     = "ВыбратьВсе";
    
    // Команда: Снять все
    КомандаСнять = Команды.Добавить("КомандаСнятьВсе");
    КомандаСнять.Заголовок      = "Снять все";
    КомандаСнять.Действие       = "СнятьВсе";
    
    // Команда: Выбор каталога бэкапа
    КомандаВыборКаталога = Команды.Добавить("КомандаВыборКаталога");
    КомандаВыборКаталога.Заголовок = "...";
    КомандаВыборКаталога.Действие  = "ВыбратьКаталогРезервныхКопий";
    
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыИнтерфейсаПрограммно()
    
    // === 1. Верхняя панель (Шапка) ===
    ГруппаШапка = Элементы.Добавить("ГруппаШапка", Тип("ГруппаФормы"));
    ГруппаШапка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаШапка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
    ГруппаШапка.ОтображатьЗаголовок = Ложь;
    
    // Левая колонка: Отборы
    ГруппаОтборы = Элементы.Добавить("ГруппаОтборы", Тип("ГруппаФормы"), ГруппаШапка);
    ГруппаОтборы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаОтборы.Заголовок = "1. Отбор файлов";
    ГруппаОтборы.ОтображатьЗаголовок = Истина;
    
    // 1. Папка / подпапка номенклатуры (строго выбор только групп/папок!)
    ПолеПапка = Элементы.Добавить("ПапкаНоменклатуры", Тип("ПолеФормы"), ГруппаОтборы);
    ПолеПапка.Вид = ВидПоляФормы.ПолеВвода;
    ПолеПапка.ПутьКДанным = "ПапкаНоменклатуры";
    ПолеПапка.Заголовок = "Папка / подпапка";
    ПолеПапка.КнопкаОчистки = Истина;
    ПолеПапка.КнопкаВыбора = Истина;
    ПолеПапка.УстановитьДействие("НачалоВыбора", "ПапкаНоменклатурыНачалоВыбора");
    
    // 2. Отдельный товар (если требуется сжать фото для одного конкретного товара)
    ПолеТовар = Элементы.Добавить("ОтдельныйТовар", Тип("ПолеФормы"), ГруппаОтборы);
    ПолеТовар.Вид = ВидПоляФормы.ПолеВвода;
    ПолеТовар.ПутьКДанным = "ОтдельныйТовар";
    ПолеТовар.Заголовок = "Отдельный товар";
    ПолеТовар.КнопкаОчистки = Истина;
    ПолеТовар.КнопкаВыбора = Истина;
    ПолеТовар.УстановитьДействие("НачалоВыбора", "ОтдельныйТоварНачалоВыбора");
    
    // 3. Вид номенклатуры (категория)
    ПолеВидНоменкл = Элементы.Добавить("ВидНоменклатуры", Тип("ПолеФормы"), ГруппаОтборы);
    ПолеВидНоменкл.Вид = ВидПоляФормы.ПолеВвода;
    ПолеВидНоменкл.ПутьКДанным = "ВидНоменклатуры";
    ПолеВидНоменкл.Заголовок = "Вид номенклатуры";
    ПолеВидНоменкл.КнопкаОчистки = Истина;
    
    ГруппаРазмерРасш = Элементы.Добавить("ГруппаРазмерРасш", Тип("ГруппаФормы"), ГруппаОтборы);
    ГруппаРазмерРасш.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаРазмерРасш.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
    ГруппаРазмерРасш.ОтображатьЗаголовок = Ложь;
    
    ПолеМинРазмер = Элементы.Добавить("МинимальныйРазмерКб", Тип("ПолеФормы"), ГруппаРазмерРасш);
    ПолеМинРазмер.Вид = ВидПоляФормы.ПолеВвода;
    ПолеМинРазмер.ПутьКДанным = "МинимальныйРазмерКб";
    ПолеМинРазмер.Ширина = 10;
    
    ПолеРасширения = Элементы.Добавить("СписокРасширений", Тип("ПолеФормы"), ГруппаРазмерРасш);
    ПолеРасширения.Вид = ВидПоляФормы.ПолеВвода;
    ПолеРасширения.ПутьКДанным = "СписокРасширений";
    
    ПолеТолькоОсновное = Элементы.Добавить("ТолькоОсновноеИзображение", Тип("ПолеФормы"), ГруппаОтборы);
    ПолеТолькоОсновное.Вид = ВидПоляФормы.ПолеФлажка;
    ПолеТолькоОсновное.ПутьКДанным = "ТолькоОсновноеИзображение";
    
    ГруппаИсточники = Элементы.Добавить("ГруппаИсточники", Тип("ГруппаФормы"), ГруппаОтборы);
    ГруппаИсточники.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаИсточники.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
    ГруппаИсточники.ОтображатьЗаголовок = Ложь;
    
    ПолеВБазе = Элементы.Добавить("ОбрабатыватьВБазе", Тип("ПолеФормы"), ГруппаИсточники);
    ПолеВБазе.Вид = ВидПоляФормы.ПолеФлажка;
    ПолеВБазе.ПутьКДанным = "ОбрабатыватьВБазе";
    
    ПолеВТомах = Элементы.Добавить("ОбрабатыватьВТомах", Тип("ПолеФормы"), ГруппаИсточники);
    ПолеВТомах.Вид = ВидПоляФормы.ПолеФлажка;
    ПолеВТомах.ПутьКДанным = "ОбрабатыватьВТомах";
    
    // Правая колонка: Параметры сжатия
    ГруппаПараметры = Элементы.Добавить("ГруппаПараметры", Тип("ГруппаФормы"), ГруппаШапка);
    ГруппаПараметры.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаПараметры.Заголовок = "2. Параметры сжатия";
    ГруппаПараметры.ОтображатьЗаголовок = Истина;
    
