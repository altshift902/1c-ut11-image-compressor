#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьСписок(Команда)
    
    ОчиститьСообщения();
    
    Если Не ЭтаФорма.ОбрабатыватьВБазе И Не ЭтаФорма.ОбрабатыватьВТомах Тогда
        ПоказатьПредупреждение(, "Не выбран ни один источник файлов (в базе / в томах)!");
        Возврат;
    КонецЕсли;
    
    ЗаполнитьСписокНаСервере();
    
    Если ЭтаФорма.СписокФайлов.Количество() = 0 Тогда
        ПоказатьОповещениеПользователя("Поиск завершен", , "Файлы картинок по заданным критериям не найдены.");
    Иначе
        ПоказатьОповещениеПользователя("Поиск завершен", , 
            СтрШаблон("Найдено файлов: %1 на сумму %2 Мб", ЭтаФорма.СписокФайлов.Количество(), ЭтаФорма.ИтогиИсходныйРазмерМб));
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСжатие(Команда)
    
    ОчиститьСообщения();
    
    ВыбранныеСтроки = ЭтаФорма.СписокФайлов.НайтиСтроки(Новый Структура("Пометка", Истина));
    Если ВыбранныеСтроки.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Не выбрано ни одной строки для сжатия (установите флажки в таблице)!");
        Возврат;
    КонецЕсли;
    
    Если ЭтаФорма.КачествоJPEG < 10 Или ЭтаФорма.КачествоJPEG > 100 Тогда
        ПоказатьПредупреждение(, "Качество JPEG должно быть в диапазоне от 10 до 100!");
        Возврат;
    КонецЕсли;
    
    Если ЭтаФорма.СоздаватьРезервнуюКопию И Не ЭтаФорма.ТестовыйРежим Тогда
        Если ПустаяСтрока(ЭтаФорма.КаталогРезервныхКопий) Тогда
            ПоказатьПредупреждение(, "Указана опция создания резервных копий, но каталог не выбран!");
            Возврат;
        КонецЕсли;
    КонецЕсли;
    
    Если Не ЭтаФорма.ТестовыйРежим Тогда
        ТекстВопроса = СтрШаблон(
            "ВНИМАНИЕ! Отключен тестовый режим." + Символы.ПС +
            "Будет выполнено реальное сжатие и перезапись %1 файлов в базе/томах." + Символы.ПС +
            "Продолжить операцию?", 
            ВыбранныеСтроки.Количество());
            
        Оповещение = Новый ОписаниеОповещения("ВыполнитьСжатиеЗавершение", ЭтотОбъект);
        ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
        Возврат;
    КонецЕсли;
    
    ТекстСообщения = ВыполнитьСжатиеНаСервере();
    ПоказатьОповещениеПользователя("Результат сжатия", , ТекстСообщения);
    
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСжатиеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        ТекстСообщения = ВыполнитьСжатиеНаСервере();
        ПоказатьОповещениеПользователя("Результат сжатия", , ТекстСообщения);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
    Для Каждого Стр Из ЭтаФорма.СписокФайлов Цикл
        Стр.Пометка = Истина;
    КонецЦикла;
    ПересчитатьВыбранныеИтоги();
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
    Для Каждого Стр Из ЭтаФорма.СписокФайлов Цикл
        Стр.Пометка = Ложь;
    КонецЦикла;
    ПересчитатьВыбранныеИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогРезервныхКопий(Команда)
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Заголовок = "Выберите каталог для сохранения оригиналов (бэкапа)";
    Если Диалог.Выбрать() Тогда
        ЭтаФорма.КаталогРезервныхКопий = Диалог.Каталог;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ПапкаНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    
    СтандартнаяОбработка = Ложь;
    
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("РежимВыбора", Истина);
    ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
    Если ЗначениеЗаполнено(ЭтаФорма.ПапкаНоменклатуры) Тогда
        ПараметрыФормы.Вставить("ТекущаяСтрока", ЭтаФорма.ПапкаНоменклатуры);
    КонецЕсли;
    
    // Открываем форму выбора групп (папок / подпапок)
    Попытка
        ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы", ПараметрыФормы, Элемент);
    Исключение
        Попытка
            ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаВыбораГруппы", ПараметрыФормы, Элемент);
        Исключение
            // Резервный вариант: стандартная форма выбора с отбором только групп
            Отбор = Новый Структура("ЭтоГруппа", Истина);
            ПараметрыФормы.Вставить("Отбор", Отбор);
            ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элемент);
        КонецПопытки;
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура ОтдельныйТоварНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    
    СтандартнаяОбработка = Ложь;
    
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("РежимВыбора", Истина);
    ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
    Если ЗначениеЗаполнено(ЭтаФорма.ОтдельныйТовар) Тогда
        ПараметрыФормы.Вставить("ТекущаяСтрока", ЭтаФорма.ОтдельныйТовар);
    КонецЕсли;
    
    // Для отдельного товара показываем только элементы (не папки)
    Отбор = Новый Структура("ЭтоГруппа", Ложь);
    ПараметрыФормы.Вставить("Отбор", Отбор);
    
    Попытка
        ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элемент);
    Исключение
        СтандартнаяОбработка = Истина;
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура СписокФайловПометкаПриИзменении(Элемент)
    ПересчитатьВыбранныеИтоги();
КонецПроцедуры

&НаКлиенте
Процедура СписокФайловПриАктивизацииСтроки(Элемент)
    ТекущаяСтрока = Элементы.СписокФайлов.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        ЭтаФорма.АдресКартинкиПредпросмотра = "";
        Возврат;
    КонецЕсли;
    ПолучитьКартинкуДляПредпросмотра(ТекущаяСтрока.ПрисоединенныйФайл);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииСервер

&НаСервере
Процедура ЗаполнитьСписокНаСервере()
    
    ЭтаФорма.СписокФайлов.Очистить();
    
    МассивРасширений = Новый Массив;
    ВсеРасширения = ПустаяСтрока(СокрЛП(ЭтаФорма.СписокРасширений));
    
    Если Не ВсеРасширения Тогда
        Части = СтрРазделить(НРег(ЭтаФорма.СписокРасширений), ",; ", Ложь);
        Для Каждого Часть Из Части Цикл
            Чистое = СтрЗаменить(СокрЛП(Часть), ".", "");
            Если Не ПустаяСтрока(Чистое) Тогда
                МассивРасширений.Добавить(Чистое);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Файлы.Ссылка КАК ПрисоединенныйФайл,
        |	Файлы.ВладелецФайла КАК Номенклатура,
        |	Номенклатура.Артикул КАК НоменклатураАртикул,
        |	Номенклатура.Наименование КАК НоменклатураНаименование,
        |	Файлы.Наименование КАК ИмяФайла,
        |	ВЫРАЗИТЬ(Файлы.Расширение КАК СТРОКА(10)) КАК Расширение,
        |	Файлы.Размер КАК РазмерБайт,
        |	Файлы.ТипХраненияФайла КАК ТипХраненияФайла,
        |	Файлы.Том КАК Том,
        |	Файлы.ПутьКФайлу КАК ПутьКФайлу,
        |	ВЫБОР
        |		КОГДА Номенклатура.ФайлКартинки = Файлы.Ссылка ТОГДА ИСТИНА
        |		ИНАЧЕ ЛОЖЬ
        |	КОНЕЦ КАК ЭтоОсновноеИзображение
        |ИЗ
        |	Справочник.НоменклатураПрисоединенныеФайлы КАК Файлы
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
        |		ПО Файлы.ВладелецФайла = Номенклатура.Ссылка
        |ГДЕ
        |	НЕ Файлы.ПометкаУдаления
        |	И НЕ Номенклатура.ПометкаУдаления
        |	И (&ВсеРасширения ИЛИ ВЫРАЗИТЬ(Файлы.Расширение КАК СТРОКА(10)) В (&МассивРасширений))
        |	И (&МинимальныйРазмерБайт = 0 ИЛИ Файлы.Размер >= &МинимальныйРазмерБайт)
        |	И (&БезОтбораПоПапке ИЛИ Номенклатура.Ссылка В ИЕРАРХИИ (&ПапкаНоменклатуры))
        |	И (&БезОтбораПоТовару ИЛИ Номенклатура.Ссылка = &ОтдельныйТовар)
        |	И (&БезОтбораПоВиду ИЛИ Номенклатура.ВидНоменклатуры = &ВидНоменклатуры)
        |	И (&ОбрабатыватьВсеИзображения ИЛИ Номенклатура.ФайлКартинки = Файлы.Ссылка)
        |	И ((&ОбрабатыватьВБазе И Файлы.ТипХраненияФайла = ЗНАЧЕНИЕ(Перечисление.ТипыХраненияФайлов.ВИнформационнойБазе))
        |		ИЛИ (&ОбрабатыватьВТомах И Файлы.ТипХраненияФайла = ЗНАЧЕНИЕ(Перечисление.ТипыХраненияФайлов.ВТомахНаДиске)))
        |УПОРЯДОЧИТЬ ПО
        |	Файлы.Размер УБЫВ";
        
    Запрос.УстановитьПараметр("ВсеРасширения", ВсеРасширения);
    Запрос.УстановитьПараметр("МассивРасширений", МассивРасширений);
    Запрос.УстановитьПараметр("МинимальныйРазмерБайт", Мин(ЭтаФорма.МинимальныйРазмерКб * 1024, 2147483647));
    Запрос.УстановитьПараметр("ПапкаНоменклатуры", ЭтаФорма.ПапкаНоменклатуры);
    Запрос.УстановитьПараметр("БезОтбораПоПапке", Не ЗначениеЗаполнено(ЭтаФорма.ПапкаНоменклатуры));
    Запрос.УстановитьПараметр("ОтдельныйТовар", ЭтаФорма.ОтдельныйТовар);
    Запрос.УстановитьПараметр("БезОтбораПоТовару", Не ЗначениеЗаполнено(ЭтаФорма.ОтдельныйТовар));
    Запрос.УстановитьПараметр("ВидНоменклатуры", ЭтаФорма.ВидНоменклатуры);
    Запрос.УстановитьПараметр("БезОтбораПоВиду", Не ЗначениеЗаполнено(ЭтаФорма.ВидНоменклатуры));
    Запрос.УстановитьПараметр("ОбрабатыватьВсеИзображения", Не ЭтаФорма.ТолькоОсновноеИзображение);
    Запрос.УстановитьПараметр("ОбрабатыватьВБазе", ЭтаФорма.ОбрабатыватьВБазе);
    Запрос.УстановитьПараметр("ОбрабатыватьВТомах", ЭтаФорма.ОбрабатыватьВТомах);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        НоваяСтрока = ЭтаФорма.СписокФайлов.Добавить();
        НоваяСтрока.Пометка                 = Истина;
        НоваяСтрока.Номенклатура            = Выборка.Номенклатура;
        НоваяСтрока.НоменклатураАртикул     = Выборка.НоменклатураАртикул;
        НоваяСтрока.ПрисоединенныйФайл      = Выборка.ПрисоединенныйФайл;
        НоваяСтрока.ИмяФайла                = Выборка.ИмяФайла;
        НоваяСтрока.Расширение              = НРег(Выборка.Расширение);
        
        Если Выборка.ТипХраненияФайла = ПредопределенноеЗначение("Перечисление.ТипыХраненияФайлов.ВИнформационнойБазе") Тогда
            НоваяСтрока.ТипХранения = "В базе";
        Иначе
            НоваяСтрока.ТипХранения = "В томе";
        КонецЕсли;
        
        НоваяСтрока.ИсходныйРазмерКб        = Окр(Выборка.РазмерБайт / 1024, 2);
        НоваяСтрока.ИсходноеРазрешение      = "—";
        НоваяСтрока.НовыйРазмерКб           = 0;
        НоваяСтрока.НовоеРазрешение         = "—";
        НоваяСтрока.ЭкономияКб              = 0;
        НоваяСтрока.ЭкономияПроцент         = 0;
        НоваяСтрока.Статус                  = "Ожидает обработки";
    КонецЦикла;
    
    ОбновитьТекстИтогов();
    
КонецПроцедуры

&НаСервере
Функция ВыполнитьСжатиеНаСервере()
    
    СжатоУспешно = 0;
    Пропущено    = 0;
    Ошибок       = 0;
    ПерваяОшибка = "";
    
    Для Каждого Стр Из ЭтаФорма.СписокФайлов Цикл
        Если Не Стр.Пометка Тогда
            Продолжить;
        КонецЕсли;
        
        СсылкаНаФайл = Стр.ПрисоединенныйФайл;
        ИсходныйРазмер = Стр.ИсходныйРазмерКб * 1024;
        
        Попытка
            ДвоичныеДанные = ПолучитьДвоичныеДанныеФайла(СсылкаНаФайл);
            Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
                ТекстОшибки = "не удалось прочитать двоичные данные файла из базы/тома";
                Стр.Статус = "Ошибка: " + ТекстОшибки;
                Ошибок = Ошибок + 1;
                Если ПустаяСтрока(ПерваяОшибка) Тогда
                    ПерваяОшибка = ТекстОшибки;
                КонецЕсли;
                Сообщить(СтрШаблон("Ошибка при чтении файла '%1' (%2): %3", Стр.ИмяФайла, Стр.Номенклатура, ТекстОшибки));
                Продолжить;
            КонецЕсли;
            
            Если ЭтаФорма.СоздаватьРезервнуюКопию И Не ЭтаФорма.ТестовыйРежим И Не ПустаяСтрока(ЭтаФорма.КаталогРезервныхКопий) Тогда
                СоздатьРезервнуюКопию(СсылкаНаФайл, ДвоичныеДанные, ЭтаФорма.КаталогРезервныхКопий);
            КонецЕсли;
            
            ПараметрыСжатия = Новый Структура;
            ПараметрыСжатия.Вставить("МаксимальнаяШирина",         ЭтаФорма.МаксимальнаяШирина);
            ПараметрыСжатия.Вставить("МаксимальнаяВысота",         ЭтаФорма.МаксимальнаяВысота);
            ПараметрыСжатия.Вставить("КачествоJPEG",               ЭтаФорма.КачествоJPEG);
            ПараметрыСжатия.Вставить("КонвертироватьВJPEG",        ЭтаФорма.КонвертироватьВJPEG);
            
            РезультатСжатия = СжатьИзображениеWIA(ДвоичныеДанные, Стр.Расширение, ПараметрыСжатия);
            
            Стр.ИсходноеРазрешение = СтрШаблон("%1 x %2", РезультатСжатия.ИсходнаяШирина, РезультатСжатия.ИсходнаяВысота);
            Стр.НовоеРазрешение    = СтрШаблон("%1 x %2", РезультатСжатия.НоваяШирина, РезультатСжатия.НоваяВысота);
            
            НовыйРазмер = РезультатСжатия.ДвоичныеДанные.Размер();
            Стр.НовыйРазмерКб = Окр(НовыйРазмер / 1024, 2);
            
            Если ЭтаФорма.НеПерезаписыватьЕслиБольше И НовыйРазмер >= ИсходныйРазмер Тогда
                Стр.ЭкономияКб      = 0;
                Стр.ЭкономияПроцент = 0;
                Стр.Статус          = "Пропущен (новый размер больше исходного)";
                Пропущено = Пропущено + 1;
                Продолжить;
            КонецЕсли;
            
            ЭкономияБайт = ИсходныйРазмер - НовыйРазмер;
            Стр.ЭкономияКб = Окр(ЭкономияБайт / 1024, 2);
            Стр.ЭкономияПроцент = ?(ИсходныйРазмер > 0, Окр((ЭкономияБайт / ИсходныйРазмер) * 100, 1), 0);
            
            Если ЭтаФорма.ТестовыйРежим Тогда
                Стр.Статус = "Тест (готов к сжатию)";
                СжатоУспешно = СжатоУспешно + 1;
            Иначе
                ЗаписатьСжатыеДанныеФайла(СсылкаНаФайл, РезультатСжатия.ДвоичныеДанные, РезультатСжатия.НовоеРасширение);
                Стр.Расширение = РезультатСжатия.НовоеРасширение;
                Стр.Статус = "Успешно сжат и сохранен";
                СжатоУспешно = СжатоУспешно + 1;
            КонецЕсли;
            
        Исключение
            ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
            Стр.Статус = "Ошибка: " + ТекстОшибки;
            Ошибок = Ошибок + 1;
            Если ПустаяСтрока(ПерваяОшибка) Тогда
                ПерваяОшибка = ТекстОшибки;
            КонецЕсли;
            Сообщить(СтрШаблон("Ошибка при сжатии файла '%1' (%2): %3", Стр.ИмяФайла, Стр.Номенклатура, ТекстОшибки));
        КонецПопытки;
    КонецЦикла;
    
    ОбновитьТекстИтогов();
    
    ТекстСообщения = СтрШаблон(
        "Обработка завершена (%1):" + Символы.ПС +
        "- Успешно: %2" + Символы.ПС +
        "- Пропущено: %3" + Символы.ПС +
        "- Ошибок: %4" + Символы.ПС +
        "- Сэкономлено: %5 Мб",
        ?(ЭтаФорма.ТестовыйРежим, "ТЕСТОВЫЙ РЕЖИМ", "РЕАЛЬНАЯ ЗАПИСЬ"),
        СжатоУспешно, Пропущено, Ошибок, ЭтаФорма.ИтогиЭкономияМб);
        
    Если Ошибок > 0 И Не ПустаяСтрока(ПерваяОшибка) Тогда
        ТекстСообщения = ТекстСообщения + Символы.ПС + Символы.ПС +
            "Текст ошибки: " + ПерваяОшибка;
    КонецЕсли;
        
    Возврат ТекстСообщения;
    
КонецФункции

&НаСервере
Функция СжатьИзображениеWIA(ДвоичныеДанные, Расширение, ПараметрыСжатия)
    
    Результат = Новый Структура;
    Результат.Вставить("ДвоичныеДанные",  ДвоичныеДанные);
    Результат.Вставить("НовоеРасширение", Расширение);
    Результат.Вставить("ИсходнаяШирина",  0);
    Результат.Вставить("ИсходнаяВысота",  0);
    Результат.Вставить("НоваяШирина",     0);
    Результат.Вставить("НоваяВысота",     0);
    
    ИмяВходногоФайла = ПолучитьИмяВременногоФайла(Расширение);
    ДвоичныеДанные.Записать(ИмяВходногоФайла);
    
    ИмяВыходногоФайла = ПолучитьИмяВременногоФайла("jpg");
    
    Попытка
        Img = Новый COMОбъект("WIA.ImageFile");
        Img.LoadFile(ИмяВходногоФайла);
        
        Результат.ИсходнаяШирина = Img.Width;
        Результат.ИсходнаяВысота = Img.Height;
        
        IP = Новый COMОбъект("WIA.ImageProcess");
        
        ТребуетсяМасштаб = (ПараметрыСжатия.МаксимальнаяШирина > 0 И Img.Width > ПараметрыСжатия.МаксимальнаяШирина)
            Или (ПараметрыСжатия.МаксимальнаяВысота > 0 И Img.Height > ПараметрыСжатия.МаксимальнаяВысота);
            
        Если ТребуетсяМасштаб Тогда
            ФильтрScale = IP.FilterInfos("Scale").FilterID;
            IP.Filters.Add(ФильтрScale);
            ИндексФильтра = IP.Filters.Count;
            IP.Filters(ИндексФильтра).Properties("MaximumWidth").Value        = ?(ПараметрыСжатия.МаксимальнаяШирина > 0, ПараметрыСжатия.МаксимальнаяШирина, Img.Width);
            IP.Filters(ИндексФильтра).Properties("MaximumHeight").Value       = ?(ПараметрыСжатия.МаксимальнаяВысота > 0, ПараметрыСжатия.МаксимальнаяВысота, Img.Height);
            IP.Filters(ИндексФильтра).Properties("PreserveAspectRatio").Value = Истина;
        КонецЕсли;
        
        Если ПараметрыСжатия.КонвертироватьВJPEG Или НРег(Расширение) = "jpg" Или НРег(Расширение) = "jpeg" Тогда
            ФильтрConvert = IP.FilterInfos("Convert").FilterID;
            IP.Filters.Add(ФильтрConvert);
            ИндексФильтра = IP.Filters.Count;
            IP.Filters(ИндексФильтра).Properties("FormatID").Value = "{B96B3CAE-0728-11D3-9D7B-0000F81EF32E}";
            IP.Filters(ИндексФильтра).Properties("Quality").Value  = ПараметрыСжатия.КачествоJPEG;
            Результат.НовоеРасширение = "jpg";
        КонецЕсли;
        
        Если IP.Filters.Count = 0 Тогда
            Результат.НоваяШирина = Img.Width;
            Результат.НоваяВысота = Img.Height;
            УдалитьФайлы(ИмяВходногоФайла);
            УдалитьФайлы(ИмяВыходногоФайла);
            Возврат Результат;
        КонецЕсли;
        
        ImgРезультат = IP.Apply(Img);
        
        Результат.НоваяШирина = ImgРезультат.Width;
        Результат.НоваяВысота = ImgРезультат.Height;
        
        ФайлПроверкаВыходной = Новый Файл(ИмяВыходногоФайла);
        Если ФайлПроверкаВыходной.Существует() Тогда
            УдалитьФайлы(ИмяВыходногоФайла);
        КонецЕсли;
        
        ImgРезультат.SaveFile(ИмяВыходногоФайла);
        
        Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВыходногоФайла);
        
        УдалитьФайлы(ИмяВходногоФайла);
        УдалитьФайлы(ИмяВыходногоФайла);
        
    Исключение
        Попытка УдалитьФайлы(ИмяВходногоФайла);  Исключение КонецПопытки;
        Попытка УдалитьФайлы(ИмяВыходногоФайла); Исключение КонецПопытки;
        ВызватьИсключение "Ошибка WIA при сжатии: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция ПолучитьДвоичныеДанныеФайла(СсылкаНаФайл)
    
    // 1. Попытка вызова стандартных процедур БСП
    Попытка
        МодульФайлы = Неопределено;
        Выполнить("МодульФайлы = ПрисоединенныеФайлы;");
        Если МодульФайлы <> Неопределено Тогда
            Данные = МодульФайлы.ПолучитьДвоичныеДанныеФайла(СсылкаНаФайл);
            Если Данные <> Неопределено Тогда
                Возврат Данные;
            КонецЕсли;
        КонецЕсли;
    Исключение
    КонецПопытки;
    
    Попытка
        МодульФайлы = Неопределено;
        Выполнить("МодульФайлы = РаботаСФайлами;");
        Если МодульФайлы <> Неопределено Тогда
            Данные = МодульФайлы.ДвоичныеДанныеФайла(СсылкаНаФайл);
            Если Данные <> Неопределено Тогда
                Возврат Данные;
            КонецЕсли;
        КонецЕсли;
    Исключение
    КонецПопытки;
    
    ТипХранения = СсылкаНаФайл.ТипХраненияФайла;
    
    // 2. Файлы в информационной базе
    Если ТипХранения = ПредопределенноеЗначение("Перечисление.ТипыХраненияФайлов.ВИнформационнойБазе") Тогда
        
        // 2а. Проверяем реквизиты объекта (в большинстве версий УТ данные хранятся прямо в объекте справочника)
        ОбъектФайл = СсылкаНаФайл.ПолучитьОбъект();
        Если ОбъектФайл <> Неопределено Тогда
            РеквизитыОбъекта = ОбъектФайл.Метаданные().Реквизиты;
            
            Если РеквизитыОбъекта.Найти("ФайлХранилище") <> Неопределено И ОбъектФайл.ФайлХранилище <> Неопределено Тогда
                Данные = ОбъектФайл.ФайлХранилище.Получить();
                Если Данные <> Неопределено Тогда
                    Возврат Данные;
                КонецЕсли;
            КонецЕсли;
            
            Если РеквизитыОбъекта.Найти("ДвоичныеДанныеФайла") <> Неопределено И ОбъектФайл.ДвоичныеДанныеФайла <> Неопределено Тогда
                Данные = ОбъектФайл.ДвоичныеДанныеФайла.Получить();
                Если Данные <> Неопределено Тогда
                    Возврат Данные;
                КонецЕсли;
            КонецЕсли;
            
            Если РеквизитыОбъекта.Найти("ХранилищеФайла") <> Неопределено И ОбъектФайл.ХранилищеФайла <> Неопределено Тогда
                Данные = ОбъектФайл.ХранилищеФайла.Получить();
                Если Данные <> Неопределено Тогда
                    Возврат Данные;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        
        // 2б. Проверяем регистр сведений ДвоичныеДанныеФайлов (только если регистр существует в метаданных!)
        Если Метаданные.РегистрыСведений.Найти("ДвоичныеДанныеФайлов") <> Неопределено Тогда
            Попытка
                Запрос = Новый Запрос;
                Запрос.Текст = 
                    "ВЫБРАТЬ ДвоичныеДанныеФайла ИЗ РегистрСведений.ДвоичныеДанныеФайлов ГДЕ ПрисоединенныйФайл = &ПрисоединенныйФайл";
                Запрос.УстановитьПараметр("ПрисоединенныйФайл", СсылкаНаФайл);
                Выборка = Запрос.Выполнить().Выбрать();
                Если Выборка.Следующий() И Выборка.ДвоичныеДанныеФайла <> Неопределено Тогда
                    Данные = Выборка.ДвоичныеДанныеФайла.Получить();
                    Если Данные <> Неопределено Тогда
                        Возврат Данные;
                    КонецЕсли;
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЕсли;
        
    // 3. Файлы в томах на диске
    ИначеЕсли ТипХранения = ПредопределенноеЗначение("Перечисление.ТипыХраненияФайлов.ВТомахНаДиске") Тогда
        ТомСсылка = СсылкаНаФайл.Том;
        Если Не ЗначениеЗаполнено(ТомСсылка) Тогда
            ВызватьИсключение "Не указан том хранения для файла: " + Строка(СсылкаНаФайл);
        КонецЕсли;
        
        ПутьКТому = ТомСсылка.ПолныйПутьWindows;
        Если ПустаяСтрока(ПутьКТому) Тогда
            ПутьКТому = ТомСсылка.ПолныйПутьLinux;
        КонецЕсли;
        
        ПолныйПутьКФайлу = ОбъединитьПути(ПутьКТому, СсылкаНаФайл.ПутьКФайлу);
        ФайлПроверка = Новый Файл(ПолныйПутьКФайлу);
        Если Не ФайлПроверка.Существует() Тогда
            ВызватьИсключение "Файл не найден на диске: " + ПолныйПутьКФайлу;
        КонецЕсли;
        
        Возврат Новый ДвоичныеДанные(ПолныйПутьКФайлу);
    КонецЕсли;
    
    Возврат Неопределено;
    
КонецФункции

&НаСервере
Процедура ЗаписатьСжатыеДанныеФайла(СсылкаНаФайл, НовыеДвоичныеДанные, НовоеРасширение)
    
    НовыйРазмер = НовыеДвоичныеДанные.Размер();
    ОбъектФайл  = СсылкаНаФайл.ПолучитьОбъект();
    
    Если ОбъектФайл = Неопределено Тогда
        ВызватьИсключение "Не удалось получить объект файла: " + Строка(СсылкаНаФайл);
    КонецЕсли;
    
    // Обязательно для БСП: разрешаем прямую программную запись реквизитов файла
    ОбъектФайл.ОбменДанными.Загрузка = Истина;
    
    СтароеРасширение = НРег(ОбъектФайл.Расширение);
    НовоеРасширение  = НРег(НовоеРасширение);
    ФорматИзменился  = (СтароеРасширение <> НовоеРасширение);
    
    ОбъектФайл.Размер                       = НовыйРазмер;
    ОбъектФайл.ДатаМодификацииУниверсальная = ТекущаяУниверсальнаяДата();
    
    Если ФорматИзменился Тогда
        ОбъектФайл.Расширение = НовоеРасширение;
        ИмяФайлаБезРасш = ОбъектФайл.Наименование;
        Если СтрЗаканчиваетсяНаТекст(ИмяФайлаБезРасш, "." + СтароеРасширение) Тогда
            ИмяФайлаБезРасш = Лев(ИмяФайлаБезРасш, СтрДлина(ИмяФайлаБезРасш) - СтрДлина(СтароеРасширение) - 1);
        КонецЕсли;
        ОбъектФайл.Наименование = ИмяФайлаБезРасш + "." + НовоеРасширение;
    КонецЕсли;
    
    Если ОбъектФайл.ТипХраненияФайла = ПредопределенноеЗначение("Перечисление.ТипыХраненияФайлов.ВИнформационнойБазе") Тогда
        
        // 1. Запись в реквизиты объекта справочника (основной вариант для версий УТ без регистра)
        РеквизитыОбъекта = ОбъектФайл.Метаданные().Реквизиты;
        
        Если РеквизитыОбъекта.Найти("ФайлХранилище") <> Неопределено Тогда
            ОбъектФайл.ФайлХранилище = Новый ХранилищеЗначения(НовыеДвоичныеДанные, Новый СжатиеДанных(9));
        КонецЕсли;
        
        Если РеквизитыОбъекта.Найти("ДвоичныеДанныеФайла") <> Неопределено Тогда
            ОбъектФайл.ДвоичныеДанныеФайла = Новый ХранилищеЗначения(НовыеДвоичныеДанные, Новый СжатиеДанных(9));
        КонецЕсли;
        
        Если РеквизитыОбъекта.Найти("ХранилищеФайла") <> Неопределено Тогда
            ОбъектФайл.ХранилищеФайла = Новый ХранилищеЗначения(НовыеДвоичныеДанные, Новый СжатиеДанных(9));
        КонецЕсли;
        
        // 2. Если регистр сведений ДвоичныеДанныеФайлов существует в конфигурации, обновляем и его
        Если Метаданные.РегистрыСведений.Найти("ДвоичныеДанныеФайлов") <> Неопределено Тогда
            Попытка
                НаборЗаписей = РегистрыСведений["ДвоичныеДанныеФайлов"].СоздатьНаборЗаписей();
                НаборЗаписей.Отбор.ПрисоединенныйФайл.Установить(СсылкаНаФайл);
                НаборЗаписей.ОбменДанными.Загрузка = Истина;
                НоваяЗапись = НаборЗаписей.Добавить();
                НоваяЗапись.ПрисоединенныйФайл     = СсылкаНаФайл;
                НоваяЗапись.ДвоичныеДанныеФайла    = Новый ХранилищеЗначения(НовыеДвоичныеДанные, Новый СжатиеДанных(9));
                НаборЗаписей.Записать();
            Исключение
            КонецПопытки;
        КонецЕсли;
        
        ОбъектФайл.Записать();
        
    ИначеЕсли ОбъектФайл.ТипХраненияФайла = ПредопределенноеЗначение("Перечисление.ТипыХраненияФайлов.ВТомахНаДиске") Тогда
        ТомСсылка = ОбъектФайл.Том;
        ПутьКТому = ТомСсылка.ПолныйПутьWindows;
        Если ПустаяСтрока(ПутьКТому) Тогда
            ПутьКТому = ТомСсылка.ПолныйПутьLinux;
        КонецЕсли;
        
        ТекущийПолныйПуть = ОбъединитьПути(ПутьКТому, ОбъектФайл.ПутьКФайлу);
        
        Если ФорматИзменился Тогда
            ОтносительныйПутьБезРасш = ОбъектФайл.ПутьКФайлу;
            Если СтрЗаканчиваетсяНаТекст(ОтносительныйПутьБезРасш, "." + СтароеРасширение) Тогда
                ОтносительныйПутьБезРасш = Лев(ОтносительныйПутьБезРасш, СтрДлина(ОтносительныйПутьБезРасш) - СтрДлина(СтароеРасширение) - 1);
            КонецЕсли;
            НовыйОтносительныйПуть = ОтносительныйПутьБезРасш + "." + НовоеРасширение;
            НовыйПолныйПуть = ОбъединитьПути(ПутьКТому, НовыйОтносительныйПуть);
            
            НовыеДвоичныеДанные.Записать(НовыйПолныйПуть);
            
            Если ВРег(ТекущийПолныйПуть) <> ВРег(НовыйПолныйПуть) Тогда
                Попытка УдалитьФайлы(ТекущийПолныйПуть); Исключение КонецПопытки;
            КонецЕсли;
            
            ОбъектФайл.ПутьКФайлу = НовыйОтносительныйПуть;
        Иначе
            НовыеДвоичныеДанные.Записать(ТекущийПолныйПуть);
        КонецЕсли;
        
        ОбъектФайл.Записать();
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура СоздатьРезервнуюКопию(СсылкаНаФайл, ДвоичныеДанные, КаталогКопий)
    Каталог = Новый Файл(КаталогКопий);
    Если Не Каталог.Существует() Тогда
        СоздатьКаталог(КаталогКопий);
    КонецЕсли;
    
    УникальныйПрефикс = Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + "_" + СтрЗаменить(Строка(СсылкаНаФайл.УникальныйИдентификатор()), "-", "");
    ИмяФайлаБэкапа = УникальныйПрефикс + "_" + СсылкаНаФайл.Наименование;
    ПолныйПутьБэкапа = ОбъединитьПути(КаталогКопий, ИмяФайлаБэкапа);
    
    ДвоичныеДанные.Записать(ПолныйПутьБэкапа);
КонецПроцедуры

&НаСервере
Процедура ПолучитьКартинкуДляПредпросмотра(СсылкаНаФайл)
    Попытка
        Двоичные = ПолучитьДвоичныеДанныеФайла(СсылкаНаФайл);
        Если Двоичные <> Неопределено Тогда
            ЭтаФорма.АдресКартинкиПредпросмотра = ПоместитьВоВременноеХранилище(Двоичные, УникальныйИдентификатор);
        Иначе
            ЭтаФорма.АдресКартинкиПредпросмотра = "";
        КонецЕсли;
    Исключение
        ЭтаФорма.АдресКартинкиПредпросмотра = "";
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстИтогов()
    ЭтаФорма.ИтогиНайдено          = ЭтаФорма.СписокФайлов.Количество();
    ЭтаФорма.ИтогиВыбрано          = 0;
    ЭтаФорма.ИтогиИсходныйРазмерМб = 0;
    ЭтаФорма.ИтогиЭкономияМб       = 0;
    СуммаИсходныйКб                = 0;
    СуммаЭкономияКб                = 0;
    
    Для Каждого Стр Из ЭтаФорма.СписокФайлов Цикл
        СуммаИсходныйКб = СуммаИсходныйКб + Стр.ИсходныйРазмерКб;
        Если Стр.Пометка Тогда
            ЭтаФорма.ИтогиВыбрано = ЭтаФорма.ИтогиВыбрано + 1;
        КонецЕсли;
        СуммаЭкономияКб = СуммаЭкономияКб + Стр.ЭкономияКб;
    КонецЦикла;
    
    ЭтаФорма.ИтогиИсходныйРазмерМб = Окр(СуммаИсходныйКб / 1024, 2);
    ЭтаФорма.ИтогиЭкономияМб       = Окр(СуммаЭкономияКб / 1024, 2);
    
    ЭтаФорма.ТекстИнформации = СтрШаблон(
        "Найдено картинок: %1 | Выбрано: %2 | Общий объем: %3 Мб | Экономия: %4 Мб",
        ЭтаФорма.ИтогиНайдено, ЭтаФорма.ИтогиВыбрано, ЭтаФорма.ИтогиИсходныйРазмерМб, ЭтаФорма.ИтогиЭкономияМб);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВыбранныеИтоги()
    Выбрано = 0;
    Для Каждого Стр Из ЭтаФорма.СписокФайлов Цикл
        Если Стр.Пометка Тогда
            Выбрано = Выбрано + 1;
        КонецЕсли;
    КонецЦикла;
    ЭтаФорма.ИтогиВыбрано = Выбрано;
    ЭтаФорма.ТекстИнформации = СтрШаблон(
        "Найдено картинок: %1 | Выбрано: %2 | Общий объем: %3 Мб | Экономия: %4 Мб",
        ЭтаФорма.ИтогиНайдено, ЭтаФорма.ИтогиВыбрано, ЭтаФорма.ИтогиИсходныйРазмерМб, ЭтаФорма.ИтогиЭкономияМб);
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеФункции

&НаСервереБезКонтекста
Функция ОбъединитьПути(Путь1, Путь2)
    Стр1 = СокрЛП(Путь1);
    Стр2 = СокрЛП(Путь2);
    
    Если СтрЗаканчиваетсяНаТекст(Стр1, "\") Или СтрЗаканчиваетсяНаТекст(Стр1, "/") Тогда
        Стр1 = Лев(Стр1, СтрДлина(Стр1) - 1);
    КонецЕсли;
    
    Если СтрНачинаетсяСТекста(Стр2, "\") Или СтрНачинаетсяСТекста(Стр2, "/") Тогда
        Стр2 = Сред(Стр2, 2);
    КонецЕсли;
    
    Возврат Стр1 + "\" + Стр2;
КонецФункции

&НаСервереБезКонтекста
Функция СтрЗаканчиваетсяНаТекст(Строка, Окончание)
    Если СтрДлина(Строка) < СтрДлина(Окончание) Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат ВРег(Прав(Строка, СтрДлина(Окончание))) = ВРег(Окончание);
КонецФункции

&НаСервереБезКонтекста
Функция СтрНачинаетсяСТекста(Строка, Начало)
    Если СтрДлина(Строка) < СтрДлина(Начало) Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат ВРег(Лев(Строка, СтрДлина(Начало))) = ВРег(Начало);
КонецФункции

#КонецОбласти


